# Non-secret build-time settings only. Never put deployment credentials here.
# APP_VERSION=0.1.0
# GIT_SHA=0123456789ab
# BUILD_TIME=2026-01-01T00:00:00.000Z

# Deployment values are injected by OpenClaw from its secrets store.
# Their values must never be saved in this file.
# AI_LAB_DEPLOY_HOST=
# AI_LAB_DEPLOY_USER=
# AI_LAB_DEPLOY_PORT=22
# AI_LAB_DEPLOY_ROOT=
# AI_LAB_DEPLOY_SSH_KEY_FILE=
